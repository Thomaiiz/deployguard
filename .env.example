# Copie para .env (que está no .gitignore) e troque os valores.
# Nunca faça commit do arquivo .env.
POSTGRES_PASSWORD=troque-esta-senha

# Chave que assina os tokens de login (mínimo 32 caracteres). Gere uma aleatória:
#   openssl rand -base64 48
# Quem tem esta chave consegue se passar por qualquer usuário: trate como senha.
AUTH_JWT_KEY=
# Primeiro administrador, criado só quando o banco não tem nenhum usuário.
# Senha com pelo menos 12 caracteres e sem o seu e-mail.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Hosts que o DeployGuard pode monitorar (allowlist).
MONITORING_ALLOWED_HOST_0=*.github.com
MONITORING_ALLOWED_HOST_1=github.com
MONITORING_ALLOWED_HOST_2=example.com

# Alertas de incidente (opcional). Cole aqui a URL de um Incoming Webhook do
# Slack ou de um webhook do Discord. Formatos: Slack, Discord ou Generic.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=Slack
# Falhas seguidas antes de abrir um incidente.
ALERT_FAILURE_THRESHOLD=2

# Quantas cópias da API subir. Com 2 ou mais, o agendador e os alertas dividem o trabalho
# pelo banco, e os avisos ao vivo chegam a todos pelo LISTEN/NOTIFY do PostgreSQL.
API_REPLICAS=2
